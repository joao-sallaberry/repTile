{
  "expo": {
    "name": "RepTile",
    "slug": "reptile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reptile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dev.joaosallaberry.reptile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFCF9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.joaosallaberry.reptile",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111318",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "specialUse"
              ],
              "specialUseSubtype": "Workout interval timer with audio cues"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-raw-sounds",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O RepTile usa a câmera para fotografar as máquinas da academia.",
          "photosPermission": "O RepTile usa suas fotos para ilustrar as máquinas da academia.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
